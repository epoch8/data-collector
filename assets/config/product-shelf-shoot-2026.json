        "continue": {
          "next": "Далее",
          "to_review": "К проверке"
        },
        "ribbon": {
          "pose_counter_sep": "·",
          "review": "Проверка и отправка",
          "scroll_form": "Шаг сбора",
          "scroll_counter": "{cur} из {total}"
        },
        "camera_pose": {
          "quality_dialog": {
            "title": "Проверка качества кадра",
