{
  "id": "product-shelf-shoot-2026",
  "name": "Съёмка продуктов",
  "version": "1.1",
  "config": {
    "flow": {
      "steps": [
        {
          "id": "store",
          "screen": "scroll_form",
          "field_ids": [
            "store_name",
            "extra_info"
          ]
        },
        {
          "id": "photo_full_counter",
          "screen": "scroll_form",
          "field_ids": [
            "photo_full_counter"
          ]
        },
        {
          "id": "photo_shelves",
          "screen": "scroll_form",
          "field_ids": [
            "photo_shelves"
          ]
        },
        {
          "id": "photo_product",
          "screen": "scroll_form",
          "field_ids": [
            "photo_product"
          ]
        },
        {
          "id": "review",
          "screen": "review"
        }
      ]
    },
    "fields": [
      {
        "field_id": "store_name",
        "type": "text_input",
        "title": "Магазин",
        "instructions": "Название или адрес торговой точки.",
        "validation": {
          "required": true
        }
      },
      {
        "field_id": "extra_info",
        "type": "text_input",
        "title": "Дополнительная информация",
        "instructions": "Например: отдел, заметки по задаче, контакт ответственного.",
        "validation": {
          "required": false
        }
      },
      {
        "field_id": "photo_full_counter",
        "type": "camera_photo",
        "title": "Прилавок целиком",
        "instructions": "Снимите весь прилавок одним или несколькими кадрами так, чтобы был виден весь витринный ряд.",
        "multiple": true,
        "validation": {
          "required": true,
          "min_items": 1
        }
      },
      {
        "field_id": "photo_shelves",
        "type": "camera_photo",
        "title": "Полки по отдельности",
        "instructions": "Отдельный снимок на каждую интересующую полку.",
        "multiple": true,
        "validation": {
          "required": true,
          "min_items": 1
        }
      },
      {
        "field_id": "photo_product",
        "type": "camera_photo",
        "title": "Конкретный товар (по желанию)",
        "instructions": "Крупный план товара — по желанию; шаг можно пропустить при отсутствии кадров.",
        "multiple": true,
        "validation": {
          "required": false
        }
      }
    ],
