# Скопируйте в test_dev/.env и при желании поменяйте значения.
# docker compose автоматически читает test_dev/.env.

# --- PostgreSQL ---
PGUSER=collector
PGPASSWORD=collector
PGDATABASE=collector
PGPORT=55432

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
INIT_BUCKET=dc-packages

# --- Acceptance (приёмник on_commit-webhook) ---
# Хост-порт сервиса. В pipeline.json проекта укажите http://localhost:18080/api/run-with-labels
# (58080 попадает в зарезервированный Windows/Hyper-V диапазон, поэтому дефолт 18080)
ACCEPTANCE_PORT=18080
