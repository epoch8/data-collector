# Скопируйте в test_dev/.env и при желании поменяйте значения.
# docker compose автоматически читает test_dev/.env.

# --- PostgreSQL ---
PGUSER=collector
PGPASSWORD=collector
PGDATABASE=collector
PGPORT=55432

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
INIT_BUCKET=dc-packages
