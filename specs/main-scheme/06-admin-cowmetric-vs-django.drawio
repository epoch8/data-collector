    <diagram id="path-a-flow" name="Путь A — adapter">
        <mxGraphModel dx="1334" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="880" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Путь A: data collector принимает пакет → adapter → cowmetric" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="28" width="720" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="entryA" value="&lt;b&gt;Точка входа A&lt;/b&gt;: событие &lt;code&gt;package commit completed&lt;/code&gt; в data→ запуск &lt;b&gt;Package Adapter&lt;/b&gt; (webhook / Celery / management command).&lt;br&gt;Мобилка и cowmetric adapter &lt;b&gt;не&lt;/b&gt; вызывают друг друга напрямую." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#0f1419;strokeColor=#8B9DC6;fontColor=#9EC5F7;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="48" y="72" width="832" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="1. POST packages + PUT blobs + manifest + commit&lt;br&gt;(уже реализовано в data collector +МП)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="148" width="340" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="2. &lt;b&gt;Package Adapter&lt;/b&gt; (новый модуль)&#10;· парсит manifest JSON&#10;· маппинг field_id → CowScan / Item flags&#10;· создаёт/обновляет Cow + CowScan&#10;· копирует файлы в S3 cowmetric (или shared bucket)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="240" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="3. cowmetric: CowScanAdmin&#10;inference, compare_inference, CVAT pipeline" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="370" width="340" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="plusA2" value="&lt;b&gt;+&lt;/b&gt;&amp;nbsp;Не меняем коллектор · ML/CVAT reuse · быстрее merge" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#1c2d44;strokeColor=#5b9bd5;fontColor=#e8eaef;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="480" y="148" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="minusA2" value="&lt;b&gt;−&lt;/b&gt; 2 системы · adapter · 2 UI · sync/дубли S3" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#3a2224;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="480" y="220" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="risk" value="&lt;b&gt;Риски&lt;/b&gt;&lt;br&gt;· Идемпотентность: повтор commit → один CowScan&lt;br&gt;· Таблица маппинга package_id ↔ cow_scan_id&lt;br&gt;· Shared bucket vs копирование blob" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#0f1419;strokeColor=#5a6578;fontColor=#9CA3AF;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="480" y="300" width="400" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;" parent="1" source="s1" target="s2" edge="1"/>
                <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D4A84B;endArrow=blockThin;" parent="1" source="s2" target="s3" edge="1"/>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="path-b-flow" name="Путь B — merge">
        <mxGraphModel dx="1334" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="920" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Путь B: перенос подсистем cowmetric в data collector" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="28" width="720" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="entryB" value="&lt;b&gt;Точка входа B&lt;/b&gt;: тот же &lt;code&gt;package commit completed&lt;/code&gt; в data collector но дальше обработка &lt;b&gt;не уходит&lt;/b&gt; в cowmetric.&lt;br&gt;Точка входа для &lt;b&gt;разработки&lt;/b&gt;: репозиторий &lt;code&gt;data collector&lt;/code&gt;&amp;nbsp;(+ перенос кода из cowmetric).&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#0f1419;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="48" y="72" width="904" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="b0" value="0. Мобилка → data_collector (как сейчас).&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="48" y="152" width="904" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="Фаза 1 — инфра&#10;MinIO/S3 storage, Redis, RQ worker в docker django" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="220" width="280" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="Фаза 2 — обогащение&lt;br&gt;ML/LLM Inference, jobs, UI запуска на пакете/сессии, визуализации" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="220" width="280" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="Фаза 3 — CVAT&#10;pipeline как сервис или упрощённый триггер" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="672" y="220" width="280" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="Фаза 4 — домен UI&lt;br&gt;Визуализации, экраны для сканов, вывод дополнительной инфорации + придумать как это должно быть в абстрактном виде и насколько абстрактно" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="320" width="904" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="plusB2" value="&lt;b&gt;+&lt;/b&gt; Одна админка · один контур данных · пакет end-to-end · roboflow-like" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#1c2d44;strokeColor=#9B7ED0;fontColor=#e8eaef;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="48" y="400" width="440" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="minusB2" value="&lt;b&gt;−&lt;/b&gt; Долго · регрессии ML · новый UX · перенос CVAT pipeline" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#3a2224;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="512" y="400" width="440" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="eB0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3DCC85;endArrow=blockThin;" edge="1" parent="1" source="b0" target="b1"/>
                <mxCell id="eB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;" parent="1" source="b1" target="b2" edge="1"/>
                <mxCell id="eB2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;" parent="1" source="b2" target="b3" edge="1"/>
                <mxCell id="eB3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5BC99A;endArrow=blockThin;" edge="1" parent="1" source="b3" target="b4">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="812" y="300"/>
                            <mxPoint x="500" y="300"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="path-c-flow" name="Путь C — гибрид">
        <mxGraphModel dx="614" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="980" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Путь C: ETL и пайплайны в data-collector · клиентская админка как UI-слой" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="28" width="900" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="entryC" value="&lt;b&gt;Точка входа C&lt;/b&gt;: &lt;code&gt;package commit completed&lt;/code&gt; в data-collector → обработка &lt;b&gt;остаётся в платформе&lt;/b&gt; (ETL, inference, DataPipe).&lt;br&gt;В cowmetric &lt;b&gt;не&lt;/b&gt; уходит дублирующий контур. Клиентская админка подключается к API/событиям платформы, а не владеет тяжёлой обработкой." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#0f1419;strokeColor=#5BC9B8;fontColor=#7DD4C8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="48" y="72" width="904" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="c0" value="0. Мобилка → data-collector: конфиг, пакет, commit (как сейчас)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="152" width="904" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="&lt;b&gt;Платформа data-collector&lt;/b&gt;&lt;br&gt;· приём пакета, S3, метаданные сессии&lt;br&gt;· &lt;b&gt;ETL&lt;/b&gt; (перенос из cowmetric / DataPipe)&lt;br&gt;· inference + RQ на входящих данных&lt;br&gt;· триггеры CVAT / pipeline «из трубы» на пакете" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e3338;strokeColor=#5BC9B8;fontColor=#D8F5F0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="220" width="440" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="&lt;b&gt;Клиентская админка&lt;/b&gt; (отдельный UI)&lt;br&gt;· просмотрщик / визуализатор / редактор пакетов и результатов&lt;br&gt;· конфиг проекта, пользователи, Firebase (как сейчас)&lt;br&gt;· &lt;b&gt;плагины&lt;/b&gt;: проектная логика поверх API платформы например: интеграция с АИС «монолит» для коров" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="512" y="220" width="440" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c4a" value="Фаза 1 — платформа&lt;br&gt;Перенос ETL, storage, inference hooks, DataPipe-триггеров в data-collector" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e3338;strokeColor=#5BC9B8;fontColor=#D8F5F0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="380" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c4b" value="Фаза 2 — тонкий UI&lt;br&gt;Экраны просмотра/правки, визуализации inference, статусы pipeline" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="372" y="380" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c4c" value="Фаза 3 — проектные плагины&lt;br&gt;Контракт расширений: домен (КРС), внешние системы (АИС), кастомные поля/экраны" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="684" y="380" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="plusC" value="&lt;b&gt;+&lt;/b&gt; Платформа единая для всех проектов · ETL/inference reuse · клиентская кастомизация - сохранение абстракции" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#1c3d44;strokeColor=#5BC9B8;fontColor=#e8eaef;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="540" width="440" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="minusC" value="&lt;b&gt;−&lt;/b&gt; Два слоя (платформа + UI) · контракт API/событий&amp;nbsp; · перенос ETL всё равно объёмный" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#3a2224;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="512" y="540" width="440" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="eC01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3DCC85;endArrow=blockThin;" parent="1" source="c0" target="c1" edge="1"/>
                <mxCell id="eC12" value="API / events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5BC9B8;endArrow=blockThin;fontSize=10;fontColor=#7DD4C8;dashed=1;" parent="1" source="c1" target="c2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eC23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;" parent="1" source="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="268" y="350"/>
                            <mxPoint x="500" y="350"/>
                        </Array>
                        <mxPoint x="500" y="360" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="eC34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;" parent="1" source="c2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="732" y="350"/>
                            <mxPoint x="500" y="350"/>
                        </Array>
                        <mxPoint x="500" y="360" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="eC4a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5BC9B8;endArrow=blockThin;" parent="1" target="c4a" edge="1"/>
                <mxCell id="eC4b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;" parent="1" source="c4a" target="c4b" edge="1"/>
                <mxCell id="eC4c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D4A84B;endArrow=blockThin;" parent="1" source="c4b" target="c4c" edge="1"/>
                <mxCell id="kbDMAAgEcuhdQTI42X10-1" value="&lt;b&gt;Что уже есть в cowmetric (UI-слой)&lt;/b&gt;&lt;br&gt;· Домен КРС: Breed → Cow → CowScan, 20+ метрик (см/кг, баллы 1–5)&lt;br&gt;· Медиа: Image/Video, bool-теги «для какого измерения», WebP/preview, S3&lt;br&gt;· Загрузка в админке: chunked multipart S3 (~5.5 GB)&lt;br&gt;· Inference: ML/LLM, RQ, сравнение прогонов (Compare)&lt;br&gt;· CVAT + DataPipe (отдельные контуры БД/контейнеров)&lt;br&gt;· CustomUser, экраны CowScanAdmin «из коробки»&lt;br&gt;&lt;br&gt;&lt;b&gt;Чего нет под Путь C в старой админке&lt;/b&gt;&lt;br&gt;· Единый manifest JSON пакета data-collector&lt;br&gt;· Динамический конфиг проекта (абстрактность)&lt;br&gt;· Firebase-пользователи коллекторов&lt;br&gt;&lt;br&gt;&lt;b&gt;Выбор: как делать клиентскую админку&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Новая админка&lt;/b&gt; (client-admin / django_server UI)&lt;br&gt;&lt;b&gt;+&lt;/b&gt; Сразу под manifest JSON платформы&lt;br&gt;&lt;b&gt;+&lt;/b&gt; Абстрактный просмотрщик → потом плагин под КРС и интеграции (АИС монолит) =&amp;gt; Сохраняем идею с платформой E8&lt;br&gt;&lt;b&gt;+&lt;/b&gt; Не трогаем legacy UI cowmetric; ETL/inference&lt;br&gt;&lt;b&gt;−&lt;/b&gt; Почти с нуля: списки, виджеты, правки, визуализации&lt;br&gt;&lt;b&gt;−&lt;/b&gt; Риск не перенести нюансы старых экранов&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Адаптация cowmetric&lt;/b&gt;&lt;br&gt;&lt;b&gt;+&lt;/b&gt; Переиспользуем готовые экраны: метрики, медиа&amp;nbsp;&lt;br&gt;&lt;b&gt;−&lt;/b&gt; Модель CowScan ≠ Package; нет единого JSON&lt;br&gt;&lt;b&gt;−&lt;/b&gt; Хардкод привязок полей/флагов; много legacy-связей&lt;br&gt;&lt;b&gt;−&lt;/b&gt; Всё равно нужны: маппинг на API платформы, визуализация, АИС" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#3a2224;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="50" width="440" height="590" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="cowmetric-deep" name="cowmetric — возможности">
        <mxGraphModel dx="1474" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1000" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="cowmetric core-server-app — детальная карта возможностей админки" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="800" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="domain" value="&lt;b&gt;Домен&lt;/b&gt;&lt;br&gt;Breed · Cow (name, gender) · CowScan (months, scan_device)&lt;br&gt;12× int см/кг + 8× score 1–5 + _desc на скане" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="72" width="320" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="media" value="&lt;b&gt;Медиа&lt;/b&gt;&lt;br&gt;CowScanItemImage / Video&lt;br&gt;Boolean-теги «для какого измерения»&lt;br&gt;WebP preview (фото авто); видео preview по кнопке&lt;br&gt;S3: move uploads/ → structured path" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="400" y="72" width="360" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="upload" value="&lt;b&gt;Загрузка&lt;/b&gt;&lt;br&gt;Admin: ChunkedUploadField + presigned multipart&lt;br&gt;API: /upload/start-upload, get-all-part-urls, complete&lt;br&gt;Лимит ~5.5 GB, chunk 5 MB, video ext" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="184" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="inf" value="&lt;b&gt;Inference&lt;/b&gt;&lt;br&gt;InferenceVersion (ML/LLM, url, token, params JSON)&lt;br&gt;run-inference на CowScan → RQ → CowScanInference&lt;br&gt;Вкладка Compare: real vs N прогонов" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="440" y="184" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cvat" value="&lt;b&gt;CVAT + Pipeline&lt;/b&gt;&lt;br&gt;DataPipe: core DB → pipeline DB → CVAT tasks&lt;br&gt;Admin: CowsCVATImage/Video (task_id readonly)&lt;br&gt;Отдельные контейнеры: pipeline, cvat, minio" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="288" width="760" height="72" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>