                <mxCell id="tabPipe" value="&lt;b&gt;Pipelines&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacingTop=2;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;fontStyle=1;" parent="wsGrp" vertex="1">
                    <mxGeometry x="108" y="74" width="100" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="tabMedia" value="&lt;b&gt;Media&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacingTop=2;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;fontStyle=1;" parent="wsGrp" vertex="1">
