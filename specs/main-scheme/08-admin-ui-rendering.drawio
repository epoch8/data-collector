                </mxCell>
                <mxCell id="dataPanel" value="&lt;b&gt;Вкладка Data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Для каждого &lt;code&gt;field&lt;/code&gt; из &lt;code&gt;config.fields&lt;/code&gt;:&lt;br&gt;Widget Resolver берёт &lt;code&gt;field.type&lt;/code&gt;&lt;br&gt;→ рисует виджет с данными из&lt;br&gt;&lt;code&gt;manifest.data.{field_id}&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#e8b4b8&quot;&gt;Плагин может добавить UI рядом с полем&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#1e2a3d;strokeColor=#5B8DEF;strokeWidth=1;fontColor=#E8EAED;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="20" y="116" width="280" height="146" as="geometry"/>
                </mxCell>
                <mxCell id="saveNote" value="&lt;b&gt;Сохранение&lt;/b&gt;: правки → PATCH manifest через API платформы (django_server)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#0f1419;strokeColor=#5a6578;fontColor=#9CA3AF;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="868" y="220" width="300" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="dataW1" value="&lt;b&gt;text_input&lt;/b&gt; cow_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#151b26;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=8;" parent="wsGrp" vertex="1">
                    <mxGeometry x="32" y="272" width="80" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="dataW2" value="&lt;b&gt;datetime&lt;/b&gt; scan_time" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#151b26;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=8;" parent="wsGrp" vertex="1">
                    <mxGeometry x="120" y="272" width="80" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="dataW3" value="&lt;b&gt;photo&lt;/b&gt; pose_1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#151b26;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=8;" parent="wsGrp" vertex="1">
                    <mxGeometry x="208" y="272" width="80" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="pipePanel" value="&lt;b&gt;Вкладка Pipelines&lt;/b&gt;&lt;br&gt;&lt;br&gt;Автоматически по &lt;code&gt;pipeline_results&lt;/code&gt;:&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#D4A84B&quot;&gt;&lt;b&gt;inference&lt;/b&gt;&lt;/span&gt; — статус, метрики&lt;br&gt;&lt;span style=&quot;color:#D4A84B&quot;&gt;&lt;b&gt;annotation&lt;/b&gt;&lt;/span&gt; — CVAT/LS разметка&lt;br&gt;&lt;span style=&quot;color:#D4A84B&quot;&gt;&lt;b&gt;metrics&lt;/b&gt;&lt;/span&gt; — GT vs inference&lt;br&gt;&lt;span style=&quot;color:#D4A84B&quot;&gt;&lt;b&gt;processing&lt;/b&gt;&lt;/span&gt; — обработанные данные" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#3d3420;strokeColor=#D4A84B;strokeWidth=1;fontColor=#F5EFE0;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="316" y="116" width="260" height="184" as="geometry"/>
                </mxCell>
                <mxCell id="mediaPanel" value="&lt;b&gt;Вкладка Media&lt;/b&gt;&lt;br&gt;&lt;br&gt;Все &lt;code&gt;blobs/*&lt;/code&gt; из manifest:&lt;br&gt;превью, скачивание, просмотр.&lt;br&gt;&lt;br&gt;Карточка кадра:&lt;br&gt;фото + метаданные камеры&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#e8b4b8&quot;&gt;Плагины добавляют overlays:&lt;br&gt;skeleton, depth map и т.д.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#1a3329;strokeColor=#3DCC85;strokeWidth=1;fontColor=#E3F7EC;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="592" y="116" width="260" height="184" as="geometry"/>
                </mxCell>
                <mxCell id="eCoreWs" value="автоматический UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6578;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#9CA3AF;exitX=0.5;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="coreGrp" target="wsGrp">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ePlgWs" value="self-discover → хуки в UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c97a7e;endArrow=blockThin;endFill=1;dashed=1;fontSize=9;fontColor=#e8b4b8;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" parent="1" source="plgBox" target="wsGrp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="termLbl" value="&lt;b&gt;Терминология и архитектура&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#F5EFE0;" vertex="1" parent="1">
                    <mxGeometry x="48" y="850" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="termGrp" value="" style="group" connectable="0" vertex="1" parent="1">
                    <mxGeometry x="48" y="878" width="1200" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="termBg" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=10 8;strokeColor=#5a6578;fillColor=#0f1419;strokeWidth=1;opacity=85;" vertex="1" parent="termGrp">
                    <mxGeometry width="1200" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="termH1" value="&lt;b&gt;Определение проекта&lt;/b&gt; (JSON, хранится на сервере)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#8BA3C4;" vertex="1" parent="termGrp">
                    <mxGeometry x="20" y="16" width="500" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="term1" value="&lt;b&gt;config.fields&lt;/b&gt; — схема данных (что собирать)&lt;br&gt;&lt;b&gt;config.flow&lt;/b&gt; — экраны МП (как собирать)&lt;br&gt;&lt;b&gt;config.pipelines&lt;/b&gt; — шаги обработки (что делать с данными)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=10;" vertex="1" parent="termGrp">
                    <mxGeometry x="20" y="40" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="termH2" value="&lt;b&gt;Расширения&lt;/b&gt; (код, per-client deployment)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#e8b4b8;" vertex="1" parent="termGrp">
                    <mxGeometry x="400" y="16" width="400" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="term2" value="&lt;b&gt;plugins&lt;/b&gt; — self-discovering расширения.&lt;br&gt;Не часть config JSON.&lt;br&gt;Устанавливаются как код под конкретного клиента.&lt;br&gt;Сами определяют, нужны ли они, по данным проекта." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1a1012;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=10;" vertex="1" parent="termGrp">
                    <mxGeometry x="400" y="40" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="termH3" value="&lt;b&gt;Приложения&lt;/b&gt; (кто потребляет)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#F5EFE0;" vertex="1" parent="termGrp">
                    <mxGeometry x="20" y="130" width="400" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="appMP" value="&lt;b&gt;МП&lt;/b&gt; (Flutter)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Коллектор — записывает данные.&lt;br&gt;Потребляет: fields + flow.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=10;" vertex="1" parent="termGrp">
                    <mxGeometry x="20" y="154" width="230" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="appColl" value="&lt;b&gt;Коллекторская админка&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Конфигуратор + приёмник данных.&lt;br&gt;Создаёт и редактирует config JSON.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=10;" vertex="1" parent="termGrp">
                    <mxGeometry x="264" y="154" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="appClient" value="&lt;b&gt;Клиентская админка&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Визуализатор + редактор.&lt;br&gt;Потребляет: fields + pipeline_results + manifest.&lt;br&gt;Расширяется plugins.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=10;" vertex="1" parent="termGrp">
                    <mxGeometry x="518" y="154" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="termH4" value="&lt;b&gt;Инфраструктура&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#F5EFE0;" vertex="1" parent="termGrp">
                    <mxGeometry x="20" y="234" width="300" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="infra" value="&lt;b&gt;django_server&lt;/b&gt; = единый бэкенд:&lt;br&gt;· REST API (для МП и клиентской админки)&lt;br&gt;· Config storage (проекты, конфиги)&lt;br&gt;· Pipeline workers (запуск inference, annotation, metrics и т.д.)&lt;br&gt;· Коллекторская админка (Django admin UI)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#15251f;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=10;strokeWidth=2;" vertex="1" parent="termGrp">
                    <mxGeometry x="20" y="258" width="740" height="68" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>