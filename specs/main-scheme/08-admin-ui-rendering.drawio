<mxfile host="65bd71144e">
    <diagram id="admin-rendering" name="Конфиг → UI клиентской админки">
        <mxGraphModel dx="1153" dy="833" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1320" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Как клиентская админка строит UI из конфига проекта" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="28" width="900" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="srcLbl" value="&lt;b&gt;&amp;nbsp;Входы&lt;/b&gt; (что приходит в админку)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#8B9DC6;" parent="1" vertex="1">
                    <mxGeometry x="48" y="76" width="500" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="srcF" value="&lt;b&gt;config.fields&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Справочник полей проекта:&lt;br&gt;&lt;code&gt;field_id&lt;/code&gt;, &lt;code&gt;type&lt;/code&gt;, &lt;code&gt;label&lt;/code&gt;, &lt;code&gt;required&lt;/code&gt;.&lt;br&gt;Тип поля → какой виджет рисовать.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="104" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="srcPp" value="&lt;b&gt;config.pipelines&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Какие шаги обработки настроены:&lt;br&gt;inference, annotation, metrics,&lt;br&gt;data_processing. Определяет что&lt;br&gt;будет в &lt;code&gt;pipeline_results&lt;/code&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="388" y="104" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="srcMn" value="&lt;b&gt;manifest пакета&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;&lt;code&gt;data.*&lt;/code&gt; — ответы формы МП&lt;br&gt;&lt;code&gt;pipeline_results.*&lt;/code&gt; — результаты обработки&lt;br&gt;&lt;code&gt;blobs/*&lt;/code&gt; — медиа файлы&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="728" y="104" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="noAU" value="&lt;span style=&quot;color:#9CA3AF&quot;&gt;config.admin_ui — &lt;b&gt;нет&lt;/b&gt;.&lt;br&gt;UI строится автоматически.&lt;br&gt;config.flow — только для МП.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1a1510;strokeColor=#5a6578;fontColor=#9CA3AF;fontSize=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="104" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="coreLbl" value="&lt;b&gt;Абстрактное ядро&lt;/b&gt; (встроено, без конфига)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#F5EFE0;" vertex="1" parent="1">
                    <mxGeometry x="48" y="232" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="coreGrp" value="" style="group" connectable="0" vertex="1" parent="1">
                    <mxGeometry x="48" y="260" width="682" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="coreBg" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;strokeColor=#5a6578;fillColor=#0f1419;fontSize=10;strokeWidth=1;" vertex="1" parent="coreGrp">
                    <mxGeometry width="682" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="core1" value="&lt;b&gt;Widget Resolver&lt;/b&gt;&lt;br&gt;&lt;code&gt;field.type&lt;/code&gt; → виджет&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;text_input → поле ввода&lt;br&gt;datetime → дата readonly&lt;br&gt;camera_photo → карточка&lt;br&gt;instruction → подсказка/информационное поле&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=6;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="coreGrp">
                    <mxGeometry x="11.366666666666667" y="14" width="154.26190476190476" height="102" as="geometry"/>
                </mxCell>
                <mxCell id="core2" value="&lt;b&gt;Pipeline Viewer&lt;/b&gt;&lt;br&gt;&lt;code&gt;pipeline_results&lt;/code&gt; → статусы&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;inference → метрики&lt;br&gt;annotation → разметка&lt;br&gt;metrics → таблица GT vs inf&lt;br&gt;processing → результат&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=6;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=9;" vertex="1" parent="coreGrp">
                    <mxGeometry x="176.9952380952381" y="14" width="154.26190476190476" height="102" as="geometry"/>
                </mxCell>
                <mxCell id="core3" value="&lt;b&gt;Media Viewer&lt;/b&gt;&lt;br&gt;&lt;code&gt;blobs/*&lt;/code&gt; → галерея&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Превью, скачивание,&lt;br&gt;карточка кадра,&lt;br&gt;frame_camera (intrinsics)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=6;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=9;" vertex="1" parent="coreGrp">
                    <mxGeometry x="342.62380952380954" y="14" width="154.26190476190476" height="102" as="geometry"/>
                </mxCell>
                <mxCell id="plgLbl" value="&lt;b&gt;Plugins&lt;/b&gt; (self-discovering, per-client)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#e8b4b8;" parent="1" vertex="1">
                    <mxGeometry x="770" y="260" width="400" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="plgBox" value="&lt;span style=&quot;color:#9CA3AF&quot;&gt;Плагин сам определяет, нужен ли он, по данным проекта.&lt;br&gt;Не в config JSON — устанавливается как код.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#E8C078&quot;&gt;Доменные:&lt;/span&gt; korovas_ais, compare_sessions&lt;br&gt;&lt;span style=&quot;color:#B8A0D8&quot;&gt;Pipeline:&lt;/span&gt; retraining, VLM, keypoint_editor&lt;br&gt;&lt;span style=&quot;color:#7DD4C8&quot;&gt;Интеграции:&lt;/span&gt; external_sync, cvat_deeplink&lt;br&gt;&lt;span style=&quot;color:#8BC9F7&quot;&gt;Визуализация:&lt;/span&gt; skeleton_overlay, depth, heatmap" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1a1012;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=9;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
                    <mxGeometry x="770" y="284" width="330" height="138" as="geometry"/>
                </mxCell>
