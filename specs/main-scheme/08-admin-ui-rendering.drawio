                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eSrcPp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D4A84B;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="srcPp" target="coreGrp">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eSrcMn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3DCC85;endArrow=blockThin;endFill=1;dashed=1;" parent="1" source="srcMn" target="coreGrp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="wsLbl" value="&lt;b&gt;&amp;nbsp;Package Workspace&lt;/b&gt; (результат рендеринга)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#F5EFE0;" parent="1" vertex="1">
