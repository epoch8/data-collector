                <mxCell id="d9" value="three.js" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#3a2224;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=9;fontStyle=1;dashed=1;dashPattern=4 4;" parent="depsGrp" vertex="1">
