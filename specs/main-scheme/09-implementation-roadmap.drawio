                <mxCell id="d9note" value="&lt;span style=&quot;color:#9CA3AF&quot;&gt;если Canvas 2D не хватит для depth map (3D point cloud)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;fontColor=#9CA3AF;" parent="depsGrp" vertex="1">
                    <mxGeometry x="124" y="276" width="460" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="legendLbl" value="&lt;b&gt;7. Ключевые принципы реализации&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#F5EFE0;" parent="1" vertex="1">
                    <mxGeometry x="648" y="1780" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;Принципы&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Config-driven UI&lt;/b&gt;: всё рисуется из &lt;code&gt;config.fields&lt;/code&gt; + &lt;code&gt;admin_ui&lt;/code&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;без хардкода экранов под конкретный проект.&lt;br&gt;&lt;br&gt;2. &lt;b&gt;Plugin = lazy React component&lt;/b&gt;: каждый плагин из&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;code&gt;config.admin_plugins&lt;/code&gt; загружается через &lt;code&gt;React.lazy()&lt;/code&gt;.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Plugin Registry маппит &lt;code&gt;plugin_id → import()&lt;/code&gt;.&lt;br&gt;&lt;br&gt;3. &lt;b&gt;Mock → Real API&lt;/b&gt;: начинаем на mock-data,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;заменяем на &lt;code&gt;fetch()&lt;/code&gt; к &lt;code&gt;django_server&lt;/code&gt; без изменения UI.&lt;br&gt;&lt;br&gt;4. &lt;b&gt;Canvas визуализации&lt;/b&gt;: skeleton, heatmap, depth —&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;все overlay-ы через нативный Canvas 2D API&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(без тяжёлых библиотек). Recharts — только для графиков.&lt;br&gt;&lt;br&gt;5. &lt;b&gt;Incremental delivery&lt;/b&gt;: каждая фаза — рабочий релиз.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Фаза 2–3 = полноценный viewer.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Фаза 4 = расширяемый. Фаза 5 = визуализация." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fillColor=#0f1419;strokeColor=#5a6578;fontColor=#E8EAED;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="648" y="1814" width="560" height="320" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>