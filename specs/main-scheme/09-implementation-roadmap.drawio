                <mxCell id="fileTree" value="&lt;pre style=&quot;font-size:11px;line-height:1.5;margin:0;color:#E8EAED&quot;&gt;src/&lt;br&gt;├── main.tsx                    &lt;span style=&quot;color:#9CA3AF&quot;&gt;# entrypoint&lt;/span&gt;&lt;br&gt;├── App.tsx                     &lt;span style=&quot;color:#9CA3AF&quot;&gt;# routes&lt;/span&gt;&lt;br&gt;├── index.css                   &lt;span style=&quot;color:#9CA3AF&quot;&gt;# tailwind imports&lt;/span&gt;&lt;br&gt;│&lt;br&gt;├── &lt;span style=&quot;color:#5B8DEF&quot;&gt;types/&lt;/span&gt;&lt;br&gt;│   ├── config.ts               &lt;span style=&quot;color:#9CA3AF&quot;&gt;# ProjectConfig, ConfigField, AdminUI&lt;/span&gt;&lt;br&gt;│   └── manifest.ts             &lt;span style=&quot;color:#9CA3AF&quot;&gt;# Manifest, PipelineResults, BlobInfo&lt;/span&gt;&lt;br&gt;│&lt;br&gt;├── &lt;span style=&quot;color:#5BC9B8&quot;&gt;api/&lt;/span&gt;&lt;br&gt;│   ├── client.ts               &lt;span style=&quot;color:#9CA3AF&quot;&gt;# REST API (mock → real)&lt;/span&gt;&lt;br&gt;│   └── mock-data.ts            &lt;span style=&quot;color:#9CA3AF&quot;&gt;# фикстуры из sample_manifest&lt;/span&gt;&lt;br&gt;│&lt;br&gt;├── &lt;span style=&quot;color:#D4A84B&quot;&gt;pages/&lt;/span&gt;&lt;br&gt;│   ├── PackageListPage.tsx&lt;br&gt;│   └── PackageWorkspacePage.tsx&lt;br&gt;│&lt;br&gt;├── &lt;span style=&quot;color:#5B8DEF&quot;&gt;components/&lt;/span&gt;&lt;br&gt;│   ├── Layout.tsx&lt;br&gt;│   ├── &lt;span style=&quot;color:#5B8DEF&quot;&gt;tabs/&lt;/span&gt;&lt;br&gt;│   │   ├── DataTab.tsx&lt;br&gt;│   │   ├── PipelinesTab.tsx&lt;br&gt;│   │   ├── MediaTab.tsx&lt;br&gt;│   │   └── JsonTab.tsx&lt;br&gt;│   └── &lt;span style=&quot;color:#5B8DEF&quot;&gt;widgets/&lt;/span&gt;&lt;br&gt;│       ├── FieldWidget.tsx      &lt;span style=&quot;color:#9CA3AF&quot;&gt;# Widget Resolver&lt;/span&gt;&lt;br&gt;│       ├── TextInputWidget.tsx&lt;br&gt;│       ├── DatetimeWidget.tsx&lt;br&gt;│       ├── CameraPhotoWidget.tsx&lt;br&gt;│       └── InstructionWidget.tsx&lt;br&gt;│&lt;br&gt;├── &lt;span style=&quot;color:#8BC9F7&quot;&gt;plugins/&lt;/span&gt;                       &lt;span style=&quot;color:#9CA3AF&quot;&gt;# lazy-loaded расширения&lt;/span&gt;&lt;br&gt;│   ├── registry.ts             &lt;span style=&quot;color:#9CA3AF&quot;&gt;# plugin_id → React.lazy(…)&lt;/span&gt;&lt;br&gt;│   └── &lt;span style=&quot;color:#8BC9F7&quot;&gt;visualization/&lt;/span&gt;&lt;br&gt;│       ├── SkeletonOverlay.tsx  &lt;span style=&quot;color:#9CA3AF&quot;&gt;# Canvas 2D keypoints&lt;/span&gt;&lt;br&gt;│       ├── MetricsChart.tsx     &lt;span style=&quot;color:#9CA3AF&quot;&gt;# Recharts graphs&lt;/span&gt;&lt;br&gt;│       ├── ErrorHeatmap.tsx     &lt;span style=&quot;color:#9CA3AF&quot;&gt;# Canvas heatmap&lt;/span&gt;&lt;br&gt;│       ├── DepthMapViewer.tsx   &lt;span style=&quot;color:#9CA3AF&quot;&gt;# Canvas/WebGL depth&lt;/span&gt;&lt;br&gt;│       ├── OverlayContainer.tsx &lt;span style=&quot;color:#9CA3AF&quot;&gt;# img + canvas wrapper&lt;/span&gt;&lt;br&gt;│       └── colorScales.ts      &lt;span style=&quot;color:#9CA3AF&quot;&gt;# turbo, viridis LUTs&lt;/span&gt;&lt;br&gt;│&lt;br&gt;└── &lt;span style=&quot;color:#7DD4C8&quot;&gt;hooks/&lt;/span&gt;&lt;br&gt;    ├── useWorkspace.ts&lt;br&gt;    ├── usePackages.ts&lt;br&gt;    ├── useCanvasResize.ts&lt;br&gt;    └── useImageLoader.ts&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;spacingTop=12;fillColor=#0f1419;strokeColor=#5a6578;fontColor=#E8EAED;fontSize=10;" parent="1" vertex="1">
