                <mxCell id="d3" value="tailwindcss" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;fontStyle=1;" parent="depsGrp" vertex="1">
