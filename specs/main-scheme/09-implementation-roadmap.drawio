                <mxCell id="ph1" value="&lt;b&gt;Фаза 1 · Фундамент&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#3DCC85&quot;&gt;✓&lt;/span&gt;&amp;nbsp;Vite + React + TS + Tailwind&lt;br&gt;&lt;span style=&quot;color:#3DCC85&quot;&gt;✓&lt;/span&gt; TypeScript типы: &lt;code&gt;Config&lt;/code&gt;, &lt;code&gt;Manifest&lt;/code&gt;, &lt;code&gt;Field&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#3DCC85&quot;&gt;✓&lt;/span&gt; Mock API client&amp;nbsp;&lt;br&gt;&lt;span style=&quot;color:#3DCC85&quot;&gt;✓&lt;/span&gt; React Router: &lt;code&gt;/packages&lt;/code&gt;, &lt;code&gt;/:id&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#3DCC85&quot;&gt;✓&lt;/span&gt; Layout: sidebar + main area" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#15251f;strokeColor=#3DCC85;strokeWidth=2;fontColor=#E3F7EC;fontSize=10;" parent="1" vertex="1">
