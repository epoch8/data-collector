<mxfile host="65bd71144e">
    <diagram id="upload-flow" name="Загрузка пакета (08)">
        <mxGraphModel dx="1334" dy="799" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t0" value="API загрузки пакета · specs/08-server-api-package-upload.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="240" y="32" width="560" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="laneL" value="КЛИЕНТ" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#5B8DEF;" parent="1" vertex="1">
                    <mxGeometry x="240" y="72" width="100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="laneR" value="СЕРВЕР" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#8B9DC6;" parent="1" vertex="1">
                    <mxGeometry x="820" y="72" width="100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Сессия (черновик)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;POST …/projects/{id}/packages&lt;/span&gt;&lt;br&gt;&lt;br&gt;Тело: &lt;b&gt;package_id&lt;/b&gt; (обяз.) · по желанию &lt;i&gt;device_id&lt;/i&gt;, &lt;i&gt;client_version&lt;/i&gt;, &lt;i&gt;created_at&lt;/i&gt; — для логов и аудита (кто/когда/с какого клиента).&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#8FD9B0&quot;&gt;Зачем сессия:&lt;/span&gt; зарегистрировать пакет, фаза «ждём блобы», &lt;b&gt;GET&lt;/b&gt; статуса, TTL черновика, одна точка идемпотентности для всей загрузки." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=8;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="240" y="100" width="400" height="168" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Каждый файл — отдельный запрос&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;PUT …/packages/{package_id}/blobs/{blob_path}&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Почему PUT:&lt;/b&gt; у файла уже есть стабильный URL (путь как в манифесте). Повтор того же &lt;b&gt;PUT&lt;/b&gt; = идемпотентно (докачка после обрыва)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=8;fillColor=#1e2438;strokeColor=#6B9BD1;fontColor=#E8EAED;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="240" y="288" width="400" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="&lt;b&gt;3.&lt;/b&gt; Манифест (один JSON)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;PUT &lt;i&gt;или&lt;/i&gt; POST …/manifest&lt;/span&gt; — в продукте выбирают &lt;b&gt;один&lt;/b&gt; метод.&lt;br&gt;&lt;br&gt;&lt;b&gt;Почему не тот же метод, что у блоба:&lt;/b&gt; это другой ресурс и другой смысл («согласовать JSON со всеми уже принятыми blobs/…»). Сервер: если ссылка в JSON на файл ещё не загружена → &lt;b&gt;422&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="240" y="416" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="&lt;b&gt;4.&lt;/b&gt; Финализация&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;POST …/commit&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Почему POST:&lt;/b&gt; это &lt;i&gt;действие&lt;/i&gt; «закрыть приёмку», а не запись по произвольному URL. После &lt;b&gt;2xx&lt;/b&gt; — пакет &lt;i&gt;completed&lt;/i&gt;; повторы &lt;b&gt;commit&lt;/b&gt; без дублей в очереди обработки (спека §11.4)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="240" y="552" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="s0" value="&lt;b&gt;Кратко на сервере&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Внешним системам пакет «готов» только после валидного манифеста + &lt;b&gt;commit&lt;/b&gt;.&lt;br&gt;· Между шагами клиент ждёт &lt;b&gt;2xx&lt;/b&gt;.&lt;br&gt;· Статусы: &lt;span style=&quot;color:#9CA3AF&quot;&gt;awaiting_blobs → … → completed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=10;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="860" y="100" width="360" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="seq1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" parent="1" source="a1" target="a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
