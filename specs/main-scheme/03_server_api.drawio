                <mxCell id="h4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D4A84B;endArrow=classic;exitX=1;exitY=0.4;entryX=0;entryY=0.95;" parent="1" source="a4" target="s0" edge="1">
