                </mxCell>
                <mxCell id="eUxgDb" value="сохранение JSON и файлов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5BC99A;endArrow=classic;fontSize=9;fontColor=#B8E8D0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;" parent="1" source="uxg" target="mdb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
