                <mxCell id="plgNote" value="&lt;span style=&quot;color:#9CA3AF&quot;&gt;Плагин рисует UI и ходит в API платформы, не в БД напрямую&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;fontColor=#9CA3AF;" parent="plgGrp" vertex="1">
