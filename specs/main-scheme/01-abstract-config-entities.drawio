<mxfile host="65bd71144e">
    <diagram id="abstract-config" name="Абстрактный конфиг — сущности и сценарии">
        <mxGraphModel dx="1651" dy="833" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1320" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Абстрактный конфиг: как собираются формы проектов (текущая модель клиента)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="36" width="720" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="f" value="&lt;b&gt;1. Поля &lt;/b&gt;(&lt;code&gt;config.fields&lt;/code&gt;)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Порядок задается порядком &lt;code&gt;field_ids&lt;/code&gt; в шаге &lt;code&gt;scroll_form&lt;/code&gt;. Каждое поле входит ровно в один шаг.&lt;br&gt;Можно сделать поле объязательным без его заполнения нельзя перейти на следующий шаг&lt;br&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="100" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s" value="&lt;b&gt;2. Экраны&lt;/b&gt; (шаги &lt;code&gt;flow.steps&lt;/code&gt;)&lt;br&gt;Сейчас в приложении: только &lt;b&gt;scroll_form&lt;/b&gt; и &lt;b&gt;review&lt;/b&gt;.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;&lt;code&gt;scroll_form&lt;/code&gt;&amp;nbsp;один скролл-экран; список &lt;code&gt;field_ids&lt;/code&gt;. &lt;code&gt;form_title&lt;/code&gt; (подпись на review)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="372" y="100" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sc" value="&lt;b&gt;3. Сценарий&lt;/b&gt; (&lt;code&gt;config.flow&lt;/code&gt;)&lt;br&gt;Упорядоченный массив шагов — порядок экранов и кнопки «Далее».&lt;br&gt;&lt;font color=&quot;#9ca3af&quot;&gt;Несколько &lt;code&gt;scroll_form&lt;/code&gt; подряд = несколько экранов сбора; в конце при желании один &lt;code&gt;review&lt;/code&gt;.&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="716" y="100" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p" value="&lt;b&gt;4. Сессия и пакет&lt;/b&gt;&lt;br&gt;Значения полей в состоянии мастера → итоговый payload пакета (в т.ч. пути к фото).&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Структура ответов согласована с API сохранения пакета и локальной БД. Проверка конфига валидатор JSON (клиент + Django).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="100" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ef" value="ссылаются по &lt;code&gt;field_id&lt;/code&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=classic;fontSize=10;fontColor=#9CA3AF;" parent="1" source="s" target="f" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="532" y="88"/>
                            <mxPoint x="198" y="88"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="es" value="шаги flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D4A84B;endArrow=classic;fontSize=10;fontColor=#E8C078;" parent="1" source="sc" target="s" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="876" y="84"/>
                            <mxPoint x="532" y="84"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="esc" value="порядок экранов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5BC99A;endArrow=classic;fontSize=10;fontColor=#B8E8D0;" parent="1" source="p" target="sc" edge="1">
                    <mxGeometry relative="1" as="geometry">
