<mxfile host="65bd71144e">
    <diagram id="abstract-config" name="Абстрактный конфиг — сущности и сценарии">
        <mxGraphModel dx="1333" dy="799" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1280" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Абстрактный конфиг: что из чего собирается&#10;папка: specs/main-scheme" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="28" width="560" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="leg" value="&lt;b&gt;Три опоры + итог:&lt;/b&gt; &lt;b&gt;поля&lt;/b&gt;, &lt;b&gt;экраны&lt;/b&gt;, &lt;b&gt;сценарий&lt;/b&gt; (порядок шагов). &lt;b&gt;Пакет&lt;/b&gt; — результат после прохождения.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Конфиг проекта = один JSON (или с сервера). Пунктир ниже — краткая сноска по типам и жёстким ограничениям, не полная документация.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#D1D5DB;" parent="1" vertex="1">
                    <mxGeometry x="48" y="76" width="1220" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="f" value="&lt;b&gt;1. Поля&lt;/b&gt;&#10;Справочник: уникальный &lt;code&gt;id&lt;/code&gt;, тип, подписи, приоритет.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Сами по себе UI не строят — только описание данных.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="140" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="s" value="&lt;b&gt;2. Экраны&lt;/b&gt;&#10;Шаг UI: как показать поля (форма, скролл, инструкция, камера…).&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Всегда ссылаются на поля по &lt;code&gt;id&lt;/code&gt; (где нужно).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="352" y="140" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="sc" value="&lt;b&gt;3. Сценарий&lt;/b&gt;&#10;Упорядоченные шаги (= экраны) и переходы «далее».&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Один путь сбора для оператора.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="656" y="140" width="300" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="p" value="&lt;b&gt;4.Конфиг JSON + вложения&amp;nbsp;&lt;/b&gt;&lt;br&gt;Итог: значения полей + вложения (фото и т.д.).&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Форма должна совпадать с ожиданием сервера/БД.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="980" y="140" width="300" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="fz" value="&lt;span style=&quot;color:#7D8FA9&quot;&gt;сноска: типы полей&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;strokeColor=#5B8DEF;fillColor=#151b26;fontColor=#B8C5D9;fontSize=10;strokeWidth=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="224" width="304" height="156" as="geometry"/>
                </mxCell>
                <mxCell id="fb1" value="&lt;b&gt;text_input&lt;/b&gt;&#10;Строка. Обязательность задаётся шагом.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;На шаге &lt;i&gt;form&lt;/i&gt; — только вместе с datetime.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="52" y="252" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb2" value="&lt;b&gt;datetime&lt;/b&gt;&#10;Дата/время.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Те же рамки, что у text_input на &lt;i&gt;form&lt;/i&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="196" y="252" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb3" value="&lt;b&gt;instruction&lt;/b&gt;&#10;Текст брифинга.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Только шаг &lt;i&gt;instruction&lt;/i&gt;, один field_id.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="52" y="316" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb4" value="&lt;b&gt;camera_photo&lt;/b&gt;&#10;Файл + контекст позы.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Только шаг &lt;i&gt;camera_pose&lt;/i&gt;; поза 1…N по порядку шагов.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="196" y="316" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="ef" value="использует id полей" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=classic;fontSize=10;fontColor=#9CA3AF;" parent="1" source="s" target="f" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="492" y="128"/>
                            <mxPoint x="188" y="128"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="es" value="шаги = экраны" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D4A84B;endArrow=classic;fontSize=10;fontColor=#E8C078;" parent="1" source="sc" target="s" edge="1">
