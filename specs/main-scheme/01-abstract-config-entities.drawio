                <mxCell id="exS2" value="&lt;b&gt;camera_pose&lt;/b&gt;&lt;br&gt;field_id: pose_1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="6">
