                <mxCell id="saveNote" value="&lt;b&gt;Сохранение&lt;/b&gt;: правки → PATCH manifest через API платформы.&lt;br&gt;Платформа проверяет наличие всех &lt;code&gt;blobs/…&lt;/code&gt; ссылок перед сохранением." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#0f1419;strokeColor=#5a6578;fontColor=#9CA3AF;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="20" y="390" width="1200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="eWrData" value="виджеты по типам полей" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DEF;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#9CA3AF;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" parent="1" source="wrGrp" target="wsGrp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
