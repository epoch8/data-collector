                <mxCell id="dataW2" value="&lt;b&gt;datetime&lt;/b&gt;&lt;br&gt;scan_time" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#151b26;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=8;" parent="wsGrp" vertex="1">
                    <mxGeometry x="150" y="282" width="106" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="dataW3" value="&lt;b&gt;camera_photo&lt;/b&gt;&lt;br&gt;pose_1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#151b26;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=8;" parent="wsGrp" vertex="1">
                    <mxGeometry x="264" y="282" width="106" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="pipePanel" value="&lt;b&gt;Вкладка Pipelines&lt;/b&gt;&lt;br&gt;&lt;br&gt;Отображает &lt;code&gt;pipeline_results&lt;/code&gt; из manifest:&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#D4A84B&quot;&gt;&lt;b&gt;inference&lt;/b&gt;&lt;/span&gt; — статус, метрики ML&lt;br&gt;&lt;span style=&quot;color:#D4A84B&quot;&gt;&lt;b&gt;cvat&lt;/b&gt;&lt;/span&gt; — статус задачи, deep link&lt;br&gt;&lt;span style=&quot;color:#5BC9B8&quot;&gt;&lt;b&gt;annotations&lt;/b&gt;&lt;/span&gt; — keypoints (skeleton из &lt;code&gt;admin_ui&lt;/code&gt;)&lt;br&gt;&lt;br&gt;MetricsTable: строки по &lt;code&gt;metric_mappings&lt;/code&gt;&lt;br&gt;GT (&lt;code&gt;data.*&lt;/code&gt;) vs inference (&lt;code&gt;metrics.*&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#3d3420;strokeColor=#D4A84B;strokeWidth=1;fontColor=#F5EFE0;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="410" y="120" width="310" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="mediaPanel" value="&lt;b&gt;Вкладка Media&lt;/b&gt;&lt;br&gt;&lt;br&gt;Все &lt;code&gt;blobs/*&lt;/code&gt; из manifest:&lt;br&gt;превью, скачивание, просмотр.&lt;br&gt;&lt;br&gt;Карточка кадра:&lt;br&gt;фото + &lt;code&gt;frame_camera&lt;/code&gt; (intrinsics)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#5BC9B8&quot;&gt;При клике → canvas с&lt;br&gt;skeleton overlay из &lt;code&gt;annotations&lt;/code&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#1a3329;strokeColor=#3DCC85;strokeWidth=1;fontColor=#E3F7EC;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="740" y="120" width="260" height="150" as="geometry"/>
