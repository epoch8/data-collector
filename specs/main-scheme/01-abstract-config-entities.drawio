                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sec3" value="&lt;b&gt;Сценарий C — один длинный экран&lt;/b&gt; (все поля сразу)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#3DCC85;" parent="1" vertex="1">
