                <mxCell id="exE45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" edge="1" parent="6" source="exS4" target="exS5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="" style="group" connectable="0" vertex="1" parent="1">
                    <mxGeometry x="460" y="252" width="340" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;strokeColor=#9B7ED0;fillColor=#18141f;fontColor=#C9B8E8;fontSize=10;strokeWidth=1;" vertex="1" parent="8">
                    <mxGeometry width="340" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;b&gt;Одна длинная форма (scroll_form)&lt;/b&gt;&lt;br&gt;Все поля проекта по &lt;code&gt;priority&lt;/code&gt;.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Других&amp;nbsp; шагов быть не должно.&lt;br&gt;Можно добавить сколько угодно полей&lt;br&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="8">
                    <mxGeometry x="28" y="70" width="280" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="&lt;b&gt;form - Анкета&lt;/b&gt;&lt;br&gt;Явный список &lt;code&gt;field_ids&lt;/code&gt;.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Только поля типов text_input и datetime (остальное — другой шаг).&amp;nbsp;&lt;br&gt;Поля заполненные тут сохраняются в хранищие визарда и потом&amp;nbsp; отображены в rewiew&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="8">
                    <mxGeometry x="20" y="180" width="284" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;instruction - справка&lt;/b&gt;&lt;br&gt;Нужен &lt;code&gt;field_id&lt;/code&gt;&amp;nbsp; поле типа instruction.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Несовпадение типа поля&amp;nbsp; приводит к ошибке конфига.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="8">
                    <mxGeometry x="20" y="260" width="284" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="&lt;b&gt;camera_pose - отдельный экран под загрузку фото&lt;/b&gt;&lt;br&gt;&lt;code&gt;field_id&lt;/code&gt;&amp;nbsp;поле типа camera_photo.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Индекс позы считается по порядку таких шагов в сценарии.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(156, 163, 175);&quot;&gt;Поля заполненные тут сохраняются в хранищие визарда и отображены в rewiew&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="8">
                    <mxGeometry x="20" y="320" width="290" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;b&gt;review&lt;/b&gt; — сводка перед отправкой. Сюда попадают поля из form и camera_pose" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#252032;strokeColor=#7a5fa8;fontColor=#DDD6EE;fontSize=9;" vertex="1" parent="8">
                    <mxGeometry x="20" y="390" width="288" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="Экраны для составных сценариев" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;fontStyle=1" vertex="1" parent="8">
                    <mxGeometry x="28" y="130" width="272" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="Экран единного сецнария" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;fontStyle=1" vertex="1" parent="8">
                    <mxGeometry x="28" y="20" width="272" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="" style="group" vertex="1" connectable="0" parent="1">
                    <mxGeometry x="38" y="250" width="304" height="156" as="geometry"/>
                </mxCell>
                <mxCell id="fz" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;strokeColor=#5B8DEF;fillColor=#151b26;fontColor=#B8C5D9;fontSize=10;strokeWidth=1;" vertex="1" parent="17">
                    <mxGeometry width="304" height="156" as="geometry"/>
                </mxCell>
                <mxCell id="fb1" value="&lt;b&gt;text_input&lt;/b&gt;&#10;Строка. Обязательность — в шаге/валидации.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;На &lt;i&gt;form&lt;/i&gt; — вместе с datetime.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="17">
                    <mxGeometry x="14" y="22" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb2" value="&lt;b&gt;datetime&lt;/b&gt;&#10;Дата/время.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Те же рамки, что text_input на &lt;i&gt;form&lt;/i&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="17">
                    <mxGeometry x="158" y="22" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb3" value="&lt;b&gt;instruction&lt;/b&gt;&#10;Текст брифинга.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Шаг &lt;i&gt;instruction&lt;/i&gt;, один field_id.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="17">
                    <mxGeometry x="14" y="86" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb4" value="&lt;b&gt;camera_photo&lt;/b&gt;&#10;Снимки + метаданные.&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Шаг &lt;i&gt;camera_pose&lt;/i&gt;; поза 1…N по порядку.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="17">
                    <mxGeometry x="158" y="86" width="136" height="56" as="geometry"/>
                </mxCell>
            </root>
