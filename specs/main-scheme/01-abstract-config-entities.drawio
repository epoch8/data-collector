                <mxCell id="jsonPanel" value="&lt;b&gt;Вкладка JSON&lt;/b&gt;&lt;br&gt;&lt;br&gt;Весь manifest целиком.&lt;br&gt;Expandable JSON tree.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Для отладки и ручных&lt;br&gt;правок «в лоб».&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#0f1419;strokeColor=#5a6578;strokeWidth=1;fontColor=#9CA3AF;fontSize=10;" parent="wsGrp" vertex="1">
