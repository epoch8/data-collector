                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="exE34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" parent="6" source="exS3" target="exS4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="exE45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" parent="6" source="exS4" target="exS5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kvUxg" value="&lt;b&gt;Korovas-2026 — конкретный UX guide&lt;/b&gt; · &lt;code&gt;config.ui.shooting_guide&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Секция&lt;/b&gt;: &lt;code&gt;section_overline&lt;/code&gt; «Обучение», &lt;code&gt;section_title&lt;/code&gt; «Съёмка», длинный &lt;code&gt;section_subtitle&lt;/code&gt; про комплект кадров и замеры.&lt;br&gt;&lt;b&gt;Советы&lt;/b&gt;: &lt;code&gt;general_tips_heading&lt;/code&gt; + 5 строк в &lt;code&gt;general_tips&lt;/code&gt;; &lt;code&gt;start_button&lt;/code&gt; «Понятно, начать съёмку»; &lt;code&gt;asset_missing_hint&lt;/code&gt; / &lt;code&gt;no_asset_placeholder&lt;/code&gt;.&lt;br&gt;&lt;b&gt;pose_cards&lt;/b&gt; (3 шт.): &lt;b&gt;1&lt;/b&gt; «Ракурс 1 — профиль» · &lt;b&gt;2&lt;/b&gt; «Ракурс 2 — спереди и сзади» · &lt;b&gt;3&lt;/b&gt; «Ракурс 3 — сверху и детали» — у всех &lt;code&gt;example_asset_path&lt;/code&gt;: &lt;code&gt;assets/korovas/example_pose_placeholder.jpg&lt;/code&gt;.&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#2a1f38;strokeColor=#E8C078;strokeWidth=2;fontColor=#FFF5E0;fontSize=9;" vertex="1" parent="6">
                    <mxGeometry x="360" y="220" width="800" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="kvEi1" value="весь гайд" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=8 5;strokeColor=#E8C078;endArrow=classic;fontSize=8;fontColor=#F5DEB3;exitX=0.5;exitY=1;entryX=0.12;entryY=0;jumpStyle=arc;" edge="1" parent="6" source="exS1" target="kvUxg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kvEp1" value="карточка 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=8 5;strokeColor=#E8C078;endArrow=classic;fontSize=8;fontColor=#F5DEB3;exitX=0.5;exitY=1;entryX=0.32;entryY=0;jumpStyle=arc;" edge="1" parent="6" source="exS2" target="kvUxg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kvEp2" value="карточка 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=8 5;strokeColor=#E8C078;endArrow=classic;fontSize=8;fontColor=#F5DEB3;exitX=0.5;exitY=1;entryX=0.52;entryY=0;jumpStyle=arc;" edge="1" parent="6" source="exS3" target="kvUxg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kvEp3" value="карточка 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=8 5;strokeColor=#E8C078;endArrow=classic;fontSize=8;fontColor=#F5DEB3;exitX=0.5;exitY=1;entryX=0.72;entryY=0;jumpStyle=arc;" edge="1" parent="6" source="exS4" target="kvUxg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="" style="group" parent="1" connectable="0" vertex="1">
                    <mxGeometry x="440" y="240" width="340" height="482" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;strokeColor=#9B7ED0;fillColor=#18141f;fontColor=#C9B8E8;fontSize=10;strokeWidth=1;" parent="8" vertex="1">
                    <mxGeometry width="340" height="482" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;b&gt;Одна длинная форма (scroll_form)&lt;/b&gt;&lt;br&gt;Все поля проекта по &lt;code&gt;priority&lt;/code&gt;.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Других&amp;nbsp; шагов быть не должно.&lt;br&gt;Можно добавить сколько угодно полей&lt;br&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" parent="8" vertex="1">
                    <mxGeometry x="28" y="70" width="280" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="&lt;b&gt;form - Анкета&lt;/b&gt;&lt;br&gt;Явный список &lt;code&gt;field_ids&lt;/code&gt;.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Только поля типов text_input и datetime (остальное — другой шаг).&amp;nbsp;&lt;br&gt;Поля заполненные тут сохраняются в хранищие визарда и потом&amp;nbsp; отображены в rewiew&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" parent="8" vertex="1">
                    <mxGeometry x="20" y="180" width="284" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;instruction — справка -- это должно быть MD&lt;/b&gt;&lt;br&gt;В &lt;code&gt;fields[]&lt;/code&gt;: &lt;code&gt;field_id&lt;/code&gt;, &lt;code&gt;priority&lt;/code&gt;, &lt;code&gt;type&lt;/code&gt;, &lt;code&gt;title&lt;/code&gt;, &lt;code&gt;instructions&lt;/code&gt;, &lt;code&gt;validation&lt;/code&gt;. В flow&amp;nbsp; шаг &lt;code&gt;instruction&lt;/code&gt; + один id.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Пунктир → отдельный блок &lt;b&gt;UX guide&lt;/b&gt;: тексты/картинки гайда съёмки не в этом поле, а в &lt;code&gt;config.ui.shooting_guide&lt;/code&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" parent="8" vertex="1">
                    <mxGeometry x="20" y="252" width="284" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="&lt;b&gt;camera_pose — ракурс&lt;/b&gt;&lt;br&gt;&lt;code&gt;field_id&lt;/code&gt; → тип &lt;code&gt;camera_photo&lt;/code&gt;. Порядок шагов = порядок ракурсов.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Пунктир → тот же &lt;b&gt;UX guide&lt;/b&gt;: подписи и пример кадра для &lt;i&gt;i&lt;/i&gt;-го ракурса из &lt;code&gt;pose_cards[i]&lt;/code&gt;.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Снимки пользователя — во визард, затем review.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" parent="8" vertex="1">
                    <mxGeometry x="20" y="328" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;b&gt;review&lt;/b&gt; — сводка перед отправкой. Сюда попадают поля из form и camera_pose" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#252032;strokeColor=#7a5fa8;fontColor=#DDD6EE;fontSize=9;" parent="8" vertex="1">
                    <mxGeometry x="20" y="412" width="288" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="Экраны для составных сценариев" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;fontStyle=1" parent="8" vertex="1">
                    <mxGeometry x="28" y="130" width="272" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="Экран единного сецнария" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;fontStyle=1" parent="8" vertex="1">
                    <mxGeometry x="28" y="20" width="272" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="" style="group" parent="1" vertex="1" connectable="0">
                    <mxGeometry x="38" y="250" width="304" height="156" as="geometry"/>
                </mxCell>
                <mxCell id="fz" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;strokeColor=#5B8DEF;fillColor=#151b26;fontColor=#B8C5D9;fontSize=10;strokeWidth=1;" parent="17" vertex="1">
                    <mxGeometry width="304" height="156" as="geometry"/>
                </mxCell>
                <mxCell id="fb1" value="&lt;b&gt;text_input&lt;/b&gt;&lt;br&gt;Строка. Обязательность — в шаге/валидации." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="14" y="22" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb2" value="&lt;b&gt;datetime&lt;/b&gt;&lt;br&gt;Дата/время.&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="158" y="22" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb3" value="&lt;b&gt;instruction&lt;/b&gt;&lt;br&gt;Текст брифинга в fields[] (см. ключи на экране instruction).&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="14" y="86" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="fb4" value="&lt;b&gt;camera_photo&lt;/b&gt;&lt;br&gt;Снимки + метаданные." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="158" y="86" width="136" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="uxg" value="&lt;b&gt;UX guide&lt;/b&gt; · это справка по проекту. &lt;br&gt;При создании экрана instruction справка будет отображаться как отдельный объязательный экран, если нет то будет окрываться только при клике на значек справки&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#C9B8E8&quot;&gt;Отдельная форма в редакторе проекта (вкладка «UI / гайд»). Не путать с полем &lt;code&gt;instruction&lt;/code&gt; в &lt;code&gt;fields[]&lt;/code&gt;&amp;nbsp; там только заголовок и текст брифинга.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Что внутри&lt;/b&gt;: &lt;code&gt;section_overline&lt;/code&gt;, &lt;code&gt;section_title&lt;/code&gt;, &lt;code&gt;section_subtitle&lt;/code&gt;, &lt;code&gt;general_tips_heading&lt;/code&gt;, &lt;code&gt;general_tips&lt;/code&gt;[], &lt;code&gt;asset_missing_hint&lt;/code&gt;, &lt;code&gt;no_asset_placeholder&lt;/code&gt;, &lt;code&gt;start_button&lt;/code&gt;.&lt;br&gt;&lt;b&gt;pose_cards[]&lt;/b&gt;: &lt;code&gt;index_1based&lt;/code&gt;, &lt;code&gt;title&lt;/code&gt;, &lt;code&gt;short_label&lt;/code&gt;, &lt;code&gt;description_lines&lt;/code&gt;[], &lt;code&gt;example_asset_path&lt;/code&gt; (картинка-пример).&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;&lt;b&gt;Можно добавить&lt;/b&gt;: карточки ракурсов, строки советов, привязать превью к файлам медиа . &lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Клиент на экране instruction показывает весь гайд; &lt;br&gt;На каждом camera_pose одну карточку ракурса по порядку шага.&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#241a32;strokeColor=#C4A8F5;strokeWidth=2;fontColor=#F0E8FF;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="858" y="254" width="430" height="318" as="geometry"/>
                </mxCell>
                <mxCell id="mdb" value="&lt;b&gt;БД + медиа проекта&lt;/b&gt;&lt;br&gt;&lt;br&gt;• В &lt;b&gt;БД&lt;/b&gt; хранится JSON проекта (&lt;code&gt;raw_json&lt;/code&gt;), вместе с блоком &lt;code&gt;ui.shooting_guide&lt;/code&gt;.&lt;br&gt;• У &lt;b&gt;каждого проекта&lt;/b&gt; свой каталог файлов на сервере (страница «Файлы»): загрузки → пути вида &lt;code&gt;uploads/…&lt;/code&gt;, в конфиге — &lt;code&gt;assets/…&lt;/code&gt; для клиента.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Эти файлы подтягиваются в превью инструкции и в примеры ракурсов (&lt;code&gt;example_asset_path&lt;/code&gt;); API: &lt;code&gt;/v1/projects/{id}/assets/…&lt;/code&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#15251f;strokeColor=#3DCC85;strokeWidth=2;fontColor=#E3F7EC;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="880" y="600" width="390" height="138" as="geometry"/>
                </mxCell>
                <mxCell id="eInstUxg" value="экран + гайд" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=10 6;strokeColor=#C4A8F5;endArrow=classic;fontSize=9;fontColor=#D8C8FF;exitX=1;exitY=0.5;entryX=0;entryY=0.28;jumpStyle=arc;" parent="1" source="12" target="uxg" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="780" y="538"/>
                            <mxPoint x="780" y="337"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="eCamUxg" value="ракурс + гайд к конкретному ракурсу&lt;br&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=10 6;strokeColor=#C4A8F5;endArrow=classic;fontSize=9;fontColor=#D8C8FF;exitX=1;exitY=0.5;entryX=0;entryY=0.62;jumpStyle=arc;" parent="1" source="13" target="uxg" edge="1">
                    <mxGeometry relative="1" as="geometry">
