                <mxCell id="exF" value="&lt;b&gt;Справочник полей&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;· &lt;code&gt;text_input&lt;/code&gt;, &lt;code&gt;datetime&lt;/code&gt; — ввод&lt;br&gt;· &lt;code&gt;instruction&lt;/code&gt; — Markdown; картинки из &lt;b&gt;медиа проекта&lt;/b&gt; (&lt;code&gt;uploads/…&lt;/code&gt;)&lt;br&gt;· &lt;code&gt;camera_photo&lt;/code&gt; — съёмка, &lt;code&gt;multiple&lt;/code&gt; при необходимости" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=10;" parent="6" vertex="1">
