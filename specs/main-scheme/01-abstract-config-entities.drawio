                <mxCell id="wsLbl" value="&lt;b&gt;Package Workspace&lt;/b&gt; — результат рендеринга" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#F5EFE0;" parent="1" vertex="1">
