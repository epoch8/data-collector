                    <mxGeometry width="320" height="168" as="geometry"/>
                </mxCell>
                <mxCell id="lblTypes" value="Типы &lt;code&gt;fields[].type&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#8BA3C4;" parent="17" vertex="1">
                    <mxGeometry x="12" y="8" width="200" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="fb1" value="&lt;b&gt;text_input&lt;/b&gt;&lt;br&gt;Строка; Можно поставить поиск по полям в локальной базе" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="14" y="32" width="140" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="fb2" value="&lt;b&gt;datetime&lt;/b&gt;&lt;br&gt;Дата и время." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="166" y="32" width="140" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="fb3" value="&lt;b&gt;instruction&lt;/b&gt;&lt;br&gt;Markdown в &lt;code&gt;instructions&lt;/code&gt;; изображения из медиа проекта." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="14" y="92" width="140" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="fb4" value="&lt;b&gt;camera_photo&lt;/b&gt;&lt;br&gt;Снимки, метаданные;&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="17" vertex="1">
                    <mxGeometry x="166" y="92" width="140" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="panel1" value="&lt;b&gt;Один экран = один &lt;code&gt;scroll_form&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Все виджеты на экране — это поля из &lt;code&gt;field_ids&lt;/code&gt; в порядке списка: текст, дата, блок инструкции (Markdown), камера, снова инструкция… как угодно комбинируя типы.&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#241a32;strokeColor=#9B7ED0;strokeWidth=1;fontColor=#E8EAED;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="450" y="289" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="mdb" value="&lt;b&gt;БД и медиа на сервере&lt;/b&gt;&lt;br&gt;&lt;br&gt;• В &lt;b&gt;БД&lt;/b&gt; хранится JSON проекта (&lt;code&gt;raw_json&lt;/code&gt;): &lt;code&gt;fields&lt;/code&gt;, &lt;code&gt;flow&lt;/code&gt;, опционально &lt;code&gt;ui&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Файлы проекта&lt;/b&gt; (страница «Файлы»): загрузки → &lt;code&gt;uploads/…&lt;/code&gt;; отдача клиенту &lt;code&gt;GET /v1/projects/{id}/assets/…&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Конфиг в приложении кэшируется с сервера в&amp;nbsp;&lt;code&gt;assets/config&lt;/code&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#15251f;strokeColor=#3DCC85;strokeWidth=2;fontColor=#E3F7EC;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="930" y="250" width="420" height="168" as="geometry"/>
                </mxCell>
                <mxCell id="eFieldsDb" value="JSON + файлы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5BC99A;endArrow=classic;fontSize=9;fontColor=#B8E8D0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;" parent="1" source="panel1" target="mdb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
