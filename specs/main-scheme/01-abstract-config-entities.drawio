    </diagram>
    <diagram id="admin-rendering" name="Конфиг → UI клиентской админки">
        <mxGraphModel dx="1080" dy="927" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1320" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Как клиентская админка отрисовывает конфиг проекта" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="28" width="900" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="srcLbl" value="&lt;b&gt;Источники&lt;/b&gt; (JSON конфиг проекта + данные пакета)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#8B9DC6;" parent="1" vertex="1">
                    <mxGeometry x="48" y="72" width="500" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="srcF" value="&lt;b&gt;config.fields&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Справочник полей: &lt;code&gt;field_id&lt;/code&gt;, &lt;code&gt;type&lt;/code&gt;, &lt;code&gt;label&lt;/code&gt;, &lt;code&gt;required&lt;/code&gt;.&lt;br&gt;Тип поля → какой виджет рисовать в админке.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="100" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="srcAU" value="&lt;b&gt;config.admin_ui&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Настройки визуализации:&lt;br&gt;&lt;code&gt;skeletons&lt;/code&gt;, &lt;code&gt;metric_mappings&lt;/code&gt;,&lt;br&gt;&lt;code&gt;widget_overrides&lt;/code&gt;, &lt;code&gt;custom_tabs&lt;/code&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e3338;strokeColor=#5BC9B8;fontColor=#D8F5F0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="348" y="100" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="srcPlg" value="&lt;b&gt;config.admin_plugins&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Проектные расширения:&lt;br&gt;&lt;code&gt;[{ id, hooks: [...] }]&lt;/code&gt;&lt;br&gt;UI-блоки + хуки в API платформы.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3a2224;strokeColor=#c97a7e;fontColor=#e8eaef;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="648" y="100" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="srcMn" value="&lt;b&gt;manifest пакета&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;&lt;code&gt;data.*&lt;/code&gt; — ответы формы МП&lt;br&gt;&lt;code&gt;pipeline_results.*&lt;/code&gt; — ML, CVAT&lt;br&gt;&lt;code&gt;_ui_meta&lt;/code&gt; — hints, ошибки, лог&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="948" y="100" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="noFlow" value="&lt;b&gt;config.flow&lt;/b&gt; — НЕ используется&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;flow — только для мобилки.&lt;br&gt;Админка строит workspace по&lt;br&gt;fields + admin_ui + manifest.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1a1510;strokeColor=#5a6578;fontColor=#9CA3AF;fontSize=10;dashed=1;dashPattern=8 6;" parent="1" vertex="1">
                    <mxGeometry x="1258" y="100" width="190" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="mapLbl" value="&lt;b&gt;Маппинг&lt;/b&gt;: конфиг → компоненты UI" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#F5EFE0;" parent="1" vertex="1">
                    <mxGeometry x="48" y="228" width="500" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="wrGrp" value="" style="group" parent="1" vertex="1" connectable="0">
                    <mxGeometry x="48" y="256" width="400" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="wrBg" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;strokeColor=#5B8DEF;fillColor=#151b26;fontSize=10;strokeWidth=1;" parent="wrGrp" vertex="1">
                    <mxGeometry width="400" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="wrLbl" value="&lt;b&gt;Widget Resolver&lt;/b&gt;: &lt;code&gt;field.type&lt;/code&gt; → виджет админки" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#8BA3C4;" parent="wrGrp" vertex="1">
                    <mxGeometry x="12" y="8" width="370" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="wr1" value="&lt;b&gt;text_input&lt;/b&gt; → Поле ввода&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;readonly или editable&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#1e2a3d;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=9;" parent="wrGrp" vertex="1">
                    <mxGeometry x="14" y="34" width="180" height="38" as="geometry"/>
                </mxCell>
