                <mxCell id="tabCustom" value="&lt;b&gt;+ custom_tabs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacingTop=2;fillColor=#0f1a1e;strokeColor=#5BC9B8;fontColor=#7DD4C8;fontSize=10;dashed=1;dashPattern=4 4;" parent="wsGrp" vertex="1">
