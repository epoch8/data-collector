                <mxCell id="dataPanel" value="&lt;b&gt;Вкладка Data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Для каждого &lt;code&gt;field&lt;/code&gt; из &lt;code&gt;config.fields&lt;/code&gt;:&lt;br&gt;1. Widget Resolver берёт &lt;code&gt;field.type&lt;/code&gt;&lt;br&gt;2. Проверяет &lt;code&gt;widget_overrides[field_id]&lt;/code&gt;&lt;br&gt;3. Рисует виджет с данными из &lt;code&gt;manifest.data.{field_id}&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#e8b4b8&quot;&gt;Плагин с хуком &lt;code&gt;data.{field_id}&lt;/code&gt; рисует доп. UI рядом с полем&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#1e2a3d;strokeColor=#5B8DEF;strokeWidth=1;fontColor=#E8EAED;fontSize=10;" parent="wsGrp" vertex="1">
                    <mxGeometry x="20" y="120" width="370" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="dataW1" value="&lt;b&gt;text_input&lt;/b&gt;&lt;br&gt;cow_identifier" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#151b26;strokeColor=#4a6fa8;fontColor=#E8EAED;fontSize=8;" parent="wsGrp" vertex="1">
                    <mxGeometry x="36" y="282" width="106" height="36" as="geometry"/>
