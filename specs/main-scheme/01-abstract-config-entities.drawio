                <mxCell id="exS3" value="&lt;b&gt;camera_pose&lt;/b&gt;&lt;br&gt;pfield_id: pose_2" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="6">
                    <mxGeometry x="772" y="52" width="100" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="exS4" value="&lt;b&gt;camera_pose&lt;/b&gt;&lt;br&gt;field_id: pose_3" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="6">
                    <mxGeometry x="892" y="52" width="100" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="exS5" value="&lt;b&gt;review&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=9;fontStyle=1" vertex="1" parent="6">
                    <mxGeometry x="1012" y="52" width="108" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="exE01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" edge="1" parent="6" source="exS0" target="exS1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="exE12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" edge="1" parent="6" source="exS1" target="exS2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="exE23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" edge="1" parent="6" source="exS2" target="exS3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="exE34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=blockThin;endFill=1;" edge="1" parent="6" source="exS3" target="exS4">
                    <mxGeometry relative="1" as="geometry"/>
