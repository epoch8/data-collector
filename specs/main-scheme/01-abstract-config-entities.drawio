                <mxCell id="foot" value="Подробности резолвера и парсера: &lt;code&gt;specs/config/json-driven-collection-ui.md&lt;/code&gt;. Домен «коровы»: &lt;code&gt;specs/korovas/&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#0f1419;strokeColor=#5a6578;fontColor=#9CA3AF;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="48" y="840" width="1230" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="" style="group" vertex="1" connectable="0" parent="1">
                    <mxGeometry x="470" y="230" width="340" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="sz" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;strokeColor=#9B7ED0;fillColor=#18141f;fontColor=#C9B8E8;fontSize=10;strokeWidth=1;" vertex="1" parent="4">
                    <mxGeometry width="340" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="sb1" value="&lt;b&gt;Одна длинная форма (scroll_form)&lt;/b&gt;&lt;br&gt;Все поля проекта по &lt;code&gt;priority&lt;/code&gt;.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Других&amp;nbsp; шагов быть не должно.&lt;br&gt;Можно добавить сколько угодно полей&lt;br&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="4">
                    <mxGeometry x="28" y="70" width="280" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="sb2" value="&lt;b&gt;form&lt;/b&gt;&lt;br&gt;Явный список &lt;code&gt;field_ids&lt;/code&gt;.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Только поля типов text_input и datetime (остальное — другой шаг).&amp;nbsp;&lt;br&gt;Поля заполненные тут сохраняются в хранищие визарда и потом могут быть отображены в rewiew&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="4">
                    <mxGeometry x="20" y="180" width="284" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="sb3" value="&lt;b&gt;instruction&lt;/b&gt;&lt;br&gt;Нужен &lt;code&gt;field_id&lt;/code&gt; → поле типа instruction.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Несовпадение типа поля&amp;nbsp; приводит к ошибке конфига.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="4">
                    <mxGeometry x="20" y="260" width="284" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="sb4" value="&lt;b&gt;camera_pose&lt;/b&gt;&lt;br&gt;&lt;code&gt;field_id&lt;/code&gt; → поле camera_photo.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Индекс позы считается по порядку таких шагов в сценарии.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(156, 163, 175);&quot;&gt;Поля заполненные тут сохраняются в хранищие визарда и потом могут быть отображены в rewiew&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#2a2438;strokeColor=#7a5fa8;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="4">
                    <mxGeometry x="20" y="320" width="290" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sb5" value="&lt;b&gt;review&lt;/b&gt; — сводка перед отправкой. Сюда можно добавить те ID из экрана form и camera_pose которые нужно проверить перед отправкой и если что исправить" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#252032;strokeColor=#7a5fa8;fontColor=#DDD6EE;fontSize=9;" vertex="1" parent="4">
                    <mxGeometry x="20" y="390" width="288" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="Экраны для составных сценариев" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;fontStyle=1" vertex="1" parent="4">
                    <mxGeometry x="28" y="130" width="272" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="Экран единного сецнария" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;fontStyle=1" vertex="1" parent="4">
                    <mxGeometry x="28" y="20" width="272" height="44" as="geometry"/>
                </mxCell>
            </root>
