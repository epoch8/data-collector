                <mxCell id="eAuWs" value="настройки вкладок и виджетов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5BC9B8;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#9CA3AF;exitX=0.5;exitY=1;entryX=0.45;entryY=0;" parent="1" source="auGrp" target="wsGrp" edge="1">
