                </mxCell>
                <mxCell id="mnMap" value="&lt;b&gt;Manifest → значения виджетов&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#3DCC85&quot;&gt;&lt;code&gt;data.{field_id}&lt;/code&gt;&lt;/span&gt; → значение поля&lt;br&gt;&lt;span style=&quot;color:#3DCC85&quot;&gt;&lt;code&gt;blobs/…&lt;/code&gt;&lt;/span&gt; → URL медиа&lt;br&gt;&lt;span style=&quot;color:#D4A84B&quot;&gt;&lt;code&gt;pipeline_results&lt;/code&gt;&lt;/span&gt; → вкладка Pipelines&lt;br&gt;&lt;span style=&quot;color:#5BC9B8&quot;&gt;&lt;code&gt;_ui_meta&lt;/code&gt;&lt;/span&gt; → подсказки и ошибки" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#15251f;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=10;" parent="1" vertex="1">
