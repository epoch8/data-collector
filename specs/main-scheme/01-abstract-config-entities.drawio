<mxfile host="65bd71144e">
    <diagram id="abstract-config" name="Абстрактный конфиг — сущности и сценарии">
        <mxGraphModel dx="850" dy="695" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1680" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Абстрактный конфиг: как собираются формы проектов" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="40" width="560" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="f" value="&lt;b&gt;1. Поля&lt;/b&gt;&lt;br&gt;Справочник: уникальный &lt;code&gt;field_id&lt;/code&gt;, тип, подписи, приоритет.&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Сами по себе UI не строят тут только описание данных и создание полей требуемых в сценарии.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="140" width="282" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s" value="&lt;b&gt;2. Экраны&lt;/b&gt;&#10;Шаг UI: как показать поля (форма, скролл, инструкция, камера…).&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Ссылаются на поля по &lt;code&gt;field_id&lt;/code&gt; (где нужно).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="352" y="140" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sc" value="&lt;b&gt;3. Сценарий&lt;/b&gt;&lt;br&gt;Упорядоченные шаги (= экраны) и переходы «далее».&lt;br&gt;&lt;font color=&quot;#9ca3af&quot;&gt;Составные сценарии могут иметь сколько угодно экрананов &lt;br&gt;Единый сценарий имеет сколько угодно полей, но один экран&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="656" y="140" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p" value="&lt;b&gt;4. Конфиг проекта&lt;/b&gt;&lt;br&gt;Итог: значения полей + вложения (фото и т.д.).&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Структура &lt;code&gt;data&lt;/code&gt; должна совпадать с ожиданием сервера/БД - внутри интрефейса есть кнопка и механизмы проверки&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="988" y="140" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ef" value="использует id полей" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8FA9;endArrow=classic;fontSize=10;fontColor=#9CA3AF;" parent="1" source="s" target="f" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="492" y="128"/>
                            <mxPoint x="188" y="128"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="es" value="шаги = экраны" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D4A84B;endArrow=classic;fontSize=10;fontColor=#E8C078;" parent="1" source="sc" target="s" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="806" y="124"/>
                            <mxPoint x="492" y="124"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="exHead" value="&lt;b&gt;Конкретный пример: Korovas&lt;/b&gt; · &lt;code&gt;assets/old/config/korovas-2026.json&lt;/code&gt; — как из полей и шагов получается сбор" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#F5EFE0;" vertex="1" parent="1">
                    <mxGeometry x="48" y="760" width="1240" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="" style="group" vertex="1" connectable="0" parent="1">
                    <mxGeometry x="38" y="792" width="1240" height="264" as="geometry"/>
                </mxCell>
                <mxCell id="exZone" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=10 8;strokeColor=#D4A84B;fillColor=#1a1510;fontColor=#9CA3AF;strokeWidth=1;opacity=85;" vertex="1" parent="6">
                    <mxGeometry width="1150" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="exF" value="&lt;b&gt;Поля в справочнике&lt;/b&gt; (сокращённо)&lt;br&gt;&lt;br&gt;· &lt;code&gt;scan_time&lt;/code&gt; — datetime&lt;br&gt;· &lt;code&gt;cow_identifier&lt;/code&gt;, &lt;code&gt;cow_age&lt;/code&gt;, &lt;code&gt;cow_weight&lt;/code&gt;, &lt;code&gt;cow_breed&lt;/code&gt; — text_input, required&lt;br&gt;· &lt;code&gt;shooting_briefing&lt;/code&gt; — instruction (длинный текст справки)&lt;br&gt;· &lt;code&gt;pose_1&lt;/code&gt; … &lt;code&gt;pose_3&lt;/code&gt; — camera_photo, &lt;i&gt;multiple&lt;/i&gt;, min 1 кадр&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=10;" vertex="1" parent="6">
                    <mxGeometry x="20" y="50" width="360" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="exFlowLbl" value="&lt;b&gt;Сценарий&amp;nbsp; Korovas 2026&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#E8C078;" vertex="1" parent="6">
                    <mxGeometry x="400" y="20" width="360" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="exS0" value="&lt;b&gt;Form&lt;/b&gt;&lt;br&gt;field_ids:&lt;br&gt;scan_time,&lt;br&gt;cow_identifier,&lt;br&gt;cow_age,&lt;br&gt;cow_weight,&lt;br&gt;cow_breed" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=4;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=9;" vertex="1" parent="6">
                    <mxGeometry x="400" y="52" width="112" height="112" as="geometry"/>
