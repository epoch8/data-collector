    <diagram id="unified-config" name="Единый конфиг — сущности (Путь C)">
        <mxGraphModel dx="1651" dy="833" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1100" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Единый конфиг проекта: МП + платформа + админка&amp;nbsp;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="48" y="28" width="900" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="f" value="&lt;b&gt;1. Поля&lt;/b&gt; (&lt;code&gt;config.fields&lt;/code&gt;)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Единый справочник для &lt;b&gt;МП&lt;/b&gt; и &lt;b&gt;админки&lt;/b&gt;.&lt;br&gt;Тип поля → виджет сбора (МП) и виджет просмотра/правки (админ).&lt;br&gt;Порядок — по &lt;code&gt;field_ids&lt;/code&gt; в шаге flow.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="48" y="90" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="fl" value="&lt;b&gt;2. Сценарий МП&lt;/b&gt; (&lt;code&gt;config.flow&lt;/code&gt;)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Порядок экранов в &lt;b&gt;мобилке&lt;/b&gt;: scroll_form, review.&lt;br&gt;Админка не использует flow — строит workspace по manifest + fields.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="368" y="90" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="pp" value="&lt;b&gt;3. Пайплайны&lt;/b&gt; (&lt;code&gt;config.pipelines&lt;/code&gt;)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Что запускать после commit:&lt;br&gt;&lt;code&gt;inference&lt;/code&gt;, &lt;code&gt;cvat&lt;/code&gt;, &lt;code&gt;annotation_sync&lt;/code&gt;.&lt;br&gt;trigger: on_commit | manual.&lt;br&gt;depends_on, version, params.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="688" y="90" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="au" value="&lt;b&gt;4. UI админки&lt;/b&gt; (&lt;code&gt;config.admin_ui&lt;/code&gt;)&lt;br&gt;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Визуализация для оператора:&lt;br&gt;skeletons, annotation_defaults,&lt;br&gt;widget_overrides, custom_tabs,&lt;br&gt;metrics_table mapping.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1e3338;strokeColor=#5BC9B8;fontColor=#D8F5F0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1008" y="90" width="300" height="110" as="geometry"/>
