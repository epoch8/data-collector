    <diagram id="client-server" name="Клиент — сервер: конфиг и приём пакета">
        <mxGraphModel dx="1094" dy="799" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="919" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
