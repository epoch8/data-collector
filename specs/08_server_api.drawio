                <mxCell id="u2" value="&lt;b&gt;История&lt;/b&gt;&#10;&lt;font color=&quot;#6EE7B7&quot;&gt;■&lt;/font&gt; на сервере (принят)&#10;&lt;font color=&quot;#FBBF24&quot;&gt;■&lt;/font&gt; только локально / не догружен" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#2a2438;strokeColor=#9B7ED0;fontColor=#E8EAED;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="660" width="320" height="88" as="geometry"/>
