<mxfile host="65bd71144e">
    <diagram id="upload-flow" name="Загрузка пакета (08)">
        <mxGraphModel dx="1344" dy="1096" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1180" background="#121218" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t0" value="Спека 08 — загрузка пакета на сервер&#10;файл: specs/08-server-api-package-upload.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1;fontColor=#E8EAED;" parent="1" vertex="1">
                    <mxGeometry x="280" y="40" width="720" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="laneL" value="КЛИЕНТ" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#5B8DEF;" vertex="1" parent="1">
                    <mxGeometry x="280" y="92" width="120" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="laneR" value="СЕРВЕР" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#8B9DC6;" vertex="1" parent="1">
                    <mxGeometry x="840" y="92" width="120" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Создать сессию пакета&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;POST …/projects/{id}/packages&lt;/span&gt;&#10;body: package_id (+ опции аудита)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="124" width="440" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Каждый файл пакета отдельно&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;PUT …/packages/{pkg}/blobs/{path}&lt;/span&gt;&#10;путь = как в манифесте · повтор PUT = идемпотентно" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1e2438;strokeColor=#6B9BD1;fontColor=#E8EAED;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="224" width="440" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="&lt;b&gt;3.&lt;/b&gt; Когда все блобы на сервере — JSON&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;PUT или POST …/manifest&lt;/span&gt;&#10;сервер проверяет: каждый &lt;i&gt;blobs/…&lt;/i&gt; из JSON уже принят" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#1a3329;strokeColor=#3DCC85;fontColor=#E3F7EC;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="336" width="440" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="&lt;b&gt;4.&lt;/b&gt; Финализация&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;POST …/commit&lt;/span&gt;&#10;пакет &lt;i&gt;completed&lt;/i&gt; · после успеха — чистка локальных блобов (спека 06 §8)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#3d3420;strokeColor=#D4A84B;fontColor=#F5EFE0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="448" width="440" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="s0" value="&lt;b&gt;Сервер (один проект, один package_id)&lt;/b&gt;&#10;&#10;· Принимает сессию и блобы&#10;· Не считает пакет готовым для внешних&#10;  потребителей без валидного манифеста&#10;· Манифест с «дыркой» в blobs → &lt;b&gt;422&lt;/b&gt;&#10;· После commit — идемпотентные повторы&#10;  без дублей в очереди обработки&#10;· На каждом шаге клиент ждёт &lt;b&gt;2xx&lt;/b&gt; перед следующим&#10;&#10;&lt;span style=&quot;color:#9CA3AF&quot;&gt;Состояния: awaiting_blobs → … → completed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#252a38;strokeColor=#8B9DC6;fontColor=#D1D5DB;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="950" y="100" width="420" height="412" as="geometry"/>
                </mxCell>
