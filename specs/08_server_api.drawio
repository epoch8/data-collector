                <mxCell id="u1" value="&lt;b&gt;Экран «Загрузка»&lt;/b&gt;&#10;неотправленные пакеты&#10;«Все» / выбранные → шаги 1–4" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#1e2a3d;strokeColor=#5B8DEF;fontColor=#E8EAED;fontSize=10;" parent="1" vertex="1">
