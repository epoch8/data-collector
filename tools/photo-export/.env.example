# Скопируйте в .env и подставьте значения (файл .env в git не коммитить).

# Postgres project DB (только чтение)
DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:6432/dc-project-korovas?sslmode=require

# S3 / Yandex Object Storage
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=dc-project-korovas
S3_PREFIX=

# AWS CLI profile (если настроен aws configure --profile yandex)
AWS_PROFILE=yandex

# Папка по умолчанию для выгрузки (локально)
OUTPUT_DIR=%USERPROFILE%\Desktop\export\korovas
